# MyTrade Environment Variables
# Copy this file to .env and fill in your actual values

# Google Cloud
GCP_PROJECT=your-gcp-project-id
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# For local development, set path to service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# API Keys - Market Data
POLYGON_API_KEY=your-polygon-api-key
ALPHA_VANTAGE_KEY=your-alphavantage-api-key
BINANCE_API_KEY=optional-binance-key
BINANCE_API_SECRET=optional-binance-secret

# API Keys - AI/LLM
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key

# API Keys - News
NEWSAPI_KEY=your-newsapi-key
FINNHUB_KEY=your-finnhub-key

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-channel-id

# Google Cloud Storage
GOOGLE_STORAGE_BUCKET=your-gcs-bucket-name

# Configuration
SHEET_TAB=MarketData
CANDLE_LIMIT=200
ROBOT=1